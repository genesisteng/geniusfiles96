<?xml version="1.0" encoding="utf-8"?>
<!--
  GeniusFiles color overrides.

  Valeurs de jour. values-night/colors.xml fournit automatiquement les
  équivalents sombres au système Android.
  Keep in sync with capacitor.config.ts (`SplashScreen.backgroundColor`)
  and src/styles.css (background CSS variable).
-->
<resources>
    <color name="splash_background">#f5f6f8</color>
    <!-- Widgets (H10) : jour. values-night fournit les équivalents sombres. -->
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_tile">#EEF0F4</color>
    <color name="widget_border">#E1E4EA</color>
    <color name="widget_track">#DDE1E8</color>
    <color name="widget_accent">#1372F0</color>
    <color name="widget_text">#15171C</color>
    <color name="widget_text_muted">#5A616B</color>
    <!-- Annonces natives avancées (AdMob) : jour. -->
    <color name="gf_ad_surface">#FFFFFF</color>
    <color name="gf_ad_border">#E1E4EA</color>
    <color name="gf_ad_text">#15171C</color>
    <color name="gf_ad_text_muted">#5A616B</color>
    <color name="gf_ad_badge_bg">#FFCC66</color>
    <color name="gf_ad_badge_text">#3A2A00</color>
    <color name="gf_ad_cta_bg">#1372F0</color>
    <color name="gf_ad_cta_text">#FFFFFF</color>
</resources>
