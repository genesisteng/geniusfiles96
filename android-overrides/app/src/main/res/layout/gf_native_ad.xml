<?xml version="1.0" encoding="utf-8"?>
<!--
  Carte d'annonce native avancée GeniusFiles (Google Mobile Ads).

  Les éléments (titre, icône, média, texte, appel à l'action) sont rendus
  par un vrai `NativeAdView` : c'est l'exigence des règles AdMob pour le
  format natif. La mention « Annonce » est obligatoire et toujours visible.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/gf_ad_card"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/gf_ad_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gf_ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/gf_ad_text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/gf_ad_attribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gf_ad_attribution"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/gf_ad_badge_text"
                        android:background="@drawable/gf_ad_badge"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/gf_ad_advertiser"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="11sp"
                        android:textColor="@color/gf_ad_text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/gf_ad_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/gf_ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/gf_ad_text_muted" />

        <Button
            android:id="@+id/gf_ad_cta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/gf_ad_cta_text"
            android:background="@drawable/gf_ad_cta" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
