<?xml version="1.0" encoding="utf-8"?>
<!--
  GeniusFiles AndroidManifest (authoritative override).

  This file is copied verbatim over the manifest generated by
  `npx cap add android`, so it MUST be a complete, self-contained manifest
  — including the LAUNCHER activity — otherwise the installed APK has no
  launcher icon and Android falls back to displaying the package name.

  Permissions cover:
    - MANAGE_EXTERNAL_STORAGE : full file-manager (Android 11+).
    - READ_MEDIA_* : granular media access (Android 13+).
    - READ/WRITE_EXTERNAL_STORAGE : legacy storage compat (Android ≤ 10).
    - FOREGROUND_SERVICE / POST_NOTIFICATIONS : long-running copy/move ops.
    - INTERNET / ACCESS_NETWORK_STATE : assistant IA.
    Audit H13 : aucune autorisation CAMERA n'est déclarée. Le scanner de
    documents passe par un `<input capture="environment">` du WebView, qui
    délègue la prise de vue à l'appareil photo du système ; déclarer CAMERA
    sans la demander à l'exécution ferait au contraire échouer la capture.

-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      App Manager (Gestionnaire d'applications):
        - QUERY_ALL_PACKAGES : list every installed package on Android 11+.
        - PACKAGE_USAGE_STATS : real per-app storage stats + last used time.
          Special access — the user must toggle it in Settings ▸ Access to
          usage data; the plugin's requestUsageAccess() opens that page.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Ouverture d'un .apk depuis le gestionnaire : Android exige cette
         autorisation pour que l'application puisse demander l'installation
         d'un paquet (l'utilisateur reste maître via « sources inconnues »). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- WAKE_LOCK n'est pas déclarée : aucun PowerManager.WakeLock n'est
         acquis. Les copies longues et la lecture audio tiennent grâce aux
         services de premier plan, pas à un verrou de réveil. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Automations: fire notifications at exact times even when the app
         is closed, and rearm alarms after a device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />


    <!-- Réseau : accès Internet pour l'assistant IA uniquement.
         Aucune fonctionnalité de transfert entre appareils : aucune
         autorisation Wi-Fi Direct / « Appareils à proximité » n'est
         demandée par GeniusFiles. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Numérisation de documents (scanner PDF) : la capture est déléguée à
         l'appareil photo du système via le WebView, aucune autorisation
         CAMERA n'est donc nécessaire. -->

    <!-- Coffre-fort : déverrouillage biométrique (empreinte / visage).
         USE_BIOMETRIC couvre Android 9+, USE_FINGERPRINT reste requis
         pour les appareils Android 8 et antérieurs. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />



    <application
        android:name="app.geniusfiles.mobile.GeniusFilesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true">

        <activity
            android:name="app.geniusfiles.mobile.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              « Ouvrir avec… » entrant : GeniusFiles se déclare comme
              lecteur/éditeur pour les types réellement pris en charge par
              la visionneuse universelle (images, vidéo, audio, PDF, texte,
              Office, ePub, archives). Aucun filtre générique */* : l'app
              n'apparaît que là où elle sait vraiment ouvrir le fichier.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>

            <!-- Partage vers GeniusFiles (un seul fichier à la fois). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>



        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Foreground service backing the audio player. Holds the media
          notification and keeps the WebView audio pipeline alive while the
          user backgrounds the app or locks the screen.
        -->
        <service
            android:name="app.geniusfiles.mobile.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


        <!--
          Moteur natif de copie / déplacement. `stopWithTask="false"` :
          la tâche continue même si l'utilisateur ferme l'application
          depuis les applications récentes.
        -->
        <service
            android:name="app.geniusfiles.mobile.FileOpsService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- Actions « Annuler » / « Ouvrir le dossier » des transferts. -->
        <receiver
            android:name="app.geniusfiles.mobile.FileOpsActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.geniusfiles.mobile.FILEOPS_CANCEL" />
                <action android:name="app.geniusfiles.mobile.FILEOPS_OPEN_DEST" />
            </intent-filter>
        </receiver>

        <!-- Fires automation notifications independently of the WebView. -->
        <receiver
            android:name="app.geniusfiles.mobile.AutomationAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.geniusfiles.mobile.AUTOMATION_FIRE" />
            </intent-filter>
        </receiver>

        <!-- Re-arms persisted automation alarms after reboot / update. -->
        <receiver
            android:name="app.geniusfiles.mobile.AutomationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!--
          Widgets écran d'accueil (H10). Les trois providers sont exportés
          (le lanceur système doit pouvoir les diffuser) mais ne reçoivent que
          les diffusions AppWidget standard ; aucune donnée sensible n'y passe.
        -->
        <receiver
            android:name="app.geniusfiles.mobile.StorageWidgetProvider"
            android:exported="true"
            android:label="@string/widget_storage_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_storage_info" />
        </receiver>

        <receiver
            android:name="app.geniusfiles.mobile.QuickAccessWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_access_info" />
        </receiver>

        <receiver
            android:name="app.geniusfiles.mobile.RecentFilesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_recent_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_info" />
        </receiver>

        <!-- Fournit les lignes du widget « Fichiers récents ». -->
        <service
            android:name="app.geniusfiles.mobile.RecentFilesWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
